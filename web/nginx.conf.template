# Nginx config for the frontend container.
# Serves the built SPA from /usr/share/nginx/html and reverse-proxies the
# management API (/api) and relay gateway (/v1) to the backend service.
#
# The backend address is templated so one image works in both topologies:
#   - docker-compose: separate containers on a user network -> host "backend"
#   - ECS Fargate:    both containers share the task network namespace, so the
#                     backend is reachable only as 127.0.0.1 (no "backend" DNS)
# nginx's official entrypoint runs envsubst over /etc/nginx/templates/*.template,
# so BACKEND_ORIGIN is substituted at container start.

upstream backend_upstream {
    server ${BACKEND_ORIGIN};
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Management API.
    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Relay gateway (/v1) — supports SSE streaming, so disable buffering.
    location /v1/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
}
